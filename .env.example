# ---------------------------------------------------------------------------
# KHABSA environment variables. Copy to .env (never commit real values).
# ---------------------------------------------------------------------------

# production | development
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# The public HTTPS address players open. Used for invite links, cookie
# "Secure" flag, CORS/Origin checks and HSTS.
PUBLIC_URL=https://khabsa.example.com
# Extra allowed origins (comma separated), e.g. a www. alias
ALLOWED_ORIGINS=

# Set to true when running behind a reverse proxy / load balancer (Render,
# Fly, Railway, Nginx...) so client IPs for rate limiting are correct.
TRUST_PROXY=true

# REQUIRED in production: 32+ random characters. Signs image tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# PostgreSQL connection string. Works with Supabase Postgres, Neon, RDS, etc.
# Supabase: Project Settings -> Database -> Connection string (use the
# "Session pooler" or direct connection, NOT the transaction pooler).
# Append ?sslmode=require for hosted databases.
# For local development you can use the embedded database: pglite:./data/pglite
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Persistent directory for uploaded avatars and private game images.
# Must be a persistent volume in production.
STORAGE_DIR=/data/storage

# Comma separated emails that become admins when they register/log in.
ADMIN_EMAILS=you@example.com

# Session lifetime in days
SESSION_DAYS=30
# Close rooms after this many idle minutes with nobody connected
ROOM_IDLE_MINUTES=30
# Seed categories/games/achievements/content on boot (idempotent)
SEED_ON_BOOT=true
# Multiplier for per-IP rate limits (raise if many players share one NAT IP)
IP_RATE_LIMIT_SCALE=1

# ---------------------------------------------------------------------------
# Voice chat (LiveKit SFU). Leave empty to disable voice (text chat still works).
# LiveKit Cloud: https://cloud.livekit.io -> Project -> Settings -> Keys
# LIVEKIT_URL looks like wss://your-project.livekit.cloud
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# TMDB posters for cartoon / movie / TV words (optional, free for non-commercial use)
# themoviedb.org -> Settings -> API -> "API Read Access Token" (starts with eyJ).
# Then approve posters in the admin dashboard: /admin/tmdb
# ---------------------------------------------------------------------------
TMDB_TOKEN=
